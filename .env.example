# ── Configuração local (.env.example) ────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores.
# Nunca suba o .env para o Git.

# Segurança
PARVATI_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
PARVATI_ADMIN_SENHA=Parvati@2026

# Banco de dados (local usa SQLite, produção usa DATABASE_URL do Render)
# DATABASE_URL=postgresql://usuario:senha@host/banco

# WhatsApp — escolha o provider e preencha as credenciais
# Opções: evolution (gratuito) | zapi | (vazio = modo simulação)
WHATSAPP_PROVIDER=evolution

# Z-API (https://z-api.io)
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API (self-hosted)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=parvati

# IA — use Claude (Anthropic) ou OpenAI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # modelo mais barato
# OPENAI_MODEL=gpt-4o-mini

# Oráculos de Lemúria
ORACULOS_PRECO_SESSAO=220
ORACULOS_PRECO_EBOOK=47
ORACULOS_LINK_SESSAO=https://link-do-seu-pagamento/sessao
ORACULOS_LINK_EBOOK=https://link-do-seu-pagamento/ebook

# Servidor local
PARVATI_HOST=0.0.0.0
PARVATI_PORT=5000
PARVATI_DEBUG=1
